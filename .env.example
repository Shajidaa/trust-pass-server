# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/trustpass_db

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret_32_chars_min
BETTER_AUTH_URL=http://localhost:5000

# Redis Configuration (Used for OTP Caching, Rate Limiting & Verification)
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP / Email Configuration (Pluggable: logs to console if empty in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Trust Pass Security <no-reply@trustpass.com>"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=