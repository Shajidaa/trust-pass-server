model Session {
    id        String   @id @default(uuid())
    expiresAt DateTime
    token     String   @unique // The actual session token
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("session")
}
