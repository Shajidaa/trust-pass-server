model TrustScoreRule {
    id        String          @id @default(uuid())
    ruleKey   String          @unique
    label     String          @db.VarChar(255)
    points    Decimal         @db.Decimal(10, 2)
    isActive  Boolean         @default(true)
    status    TrustRuleStatus
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt

    @@map("trust_score_rules")
}

model TrustScore {
    id         String @id @default(uuid())
    businessId String @unique

    score        Decimal  @db.Decimal(10, 2)
    /// JSON breakdown: { ruleKey: points, ... }
    breakdown    Json     @default("{}")
    calculatedAt DateTime @default(now())
    business     Business @relation(fields: [businessId], references: [id])

    @@index([businessId])
    @@map("trust_scores")
}

model BusinessTrustScore {
    id            String   @id @default(uuid())
    businessId    String
    business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
    ruleId        String
    pointsAwarded Int
    note          String?  @db.VarChar(500)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([businessId])
    @@index([ruleId])
    @@map("business_trust_scores")
}
