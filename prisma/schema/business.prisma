model Address {
  id          String    @id @default(uuid())
  addressLine String
  city        String    @db.VarChar(100)
  district    String    @db.VarChar(100)
  division    Division
  postalCode  String    @db.VarChar(20)
  country     Country   @default(BANGLADESH)
  business    Business?

  @@map("address")
}

model Business {
  id                    String                 @id @default(uuid())
  ownerId               String
  name                  String                 @db.VarChar(255)
  slug                  String                 @unique
  description           String?
  logoUrl               String?
  coverUrl              String?
  categoryId            String?
  businessType          BusinessType           @default(INDIVIDUAL)
  websiteUrl            String?
  instaUrl              String?
  tiktokUrl             String?
  addressId             String?                @unique
  contactEmail          String?                @db.VarChar(255)
  contactPhone          String?                @db.VarChar(30)
  verificationStatus    VerificationStatus     @default(UNVERIFIED)
  trustScore            Int                    @default(0)
  trustScoreUpdatedAt   DateTime?
  isFeatured            Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  documents             BusinessDocument[]
  trustScoreEntries     BusinessTrustScore[]
  businessVerifications BusinessVerification[]
  address               Address?               @relation(fields: [addressId], references: [id])
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products              Product[]
  reports               Report[]
  trustScores           TrustScore?

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([categoryId])
  @@map("businesses")
}
