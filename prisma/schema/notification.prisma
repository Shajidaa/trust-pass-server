model Notification {
    id        String   @id @default(uuid())
    user_id   String
    user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
    type      String
    title     String
    message   String
    isRead    Boolean  @default(false)
    createdAt DateTime @default(now())

    @@map("notification")
}
